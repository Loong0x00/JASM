<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:GIMI_ModManager.Avalonia.ViewModels"
             xmlns:items="using:GIMI_ModManager.Avalonia.ViewModels.Items"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="GIMI_ModManager.Avalonia.Views.ModsOverviewView"
             x:DataType="vm:ModsOverviewViewModel"
             x:Name="Root">

    <Grid RowDefinitions="Auto,Auto,*" Margin="24,16,24,0">
        <TextBlock Grid.Row="0" Text="模组总览" FontSize="24" FontWeight="Bold" Margin="0,0,0,8" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
            <TextBox Text="{Binding SearchText}" Watermark="搜索模组或角色…" Width="260" />
            <CheckBox Content="只看已启用" IsChecked="{Binding OnlyEnabled}" VerticalAlignment="Center" />
            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                <Run Text="共 " /><Run Text="{Binding TotalMods}" /><Run Text=" 个 · 已启用 " /><Run
                    Text="{Binding EnabledMods}" />
            </TextBlock>
        </StackPanel>

        <ScrollViewer Grid.Row="2" Margin="0,0,0,16">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="items:OverviewRow">
                        <Button Padding="0" Margin="0,0,0,6" Background="Transparent" BorderThickness="0"
                                HorizontalContentAlignment="Stretch"
                                Command="{Binding #Root.((vm:ModsOverviewViewModel)DataContext).OpenCharacterCommand}"
                                CommandParameter="{Binding}">
                            <Border Padding="12,8" CornerRadius="8"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" ClipToBounds="True"
                                            Margin="0,0,12,0"
                                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
                                        <Image Source="{Binding CharacterImagePath, Converter={StaticResource PathToBitmap}}"
                                               Stretch="UniformToFill" />
                                    </Border>
                                    <Panel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <Ellipse Width="10" Height="10" IsVisible="{Binding IsEnabled}"
                                                 Fill="{DynamicResource SystemFillColorSuccessBrush}" />
                                        <Ellipse Width="10" Height="10" IsVisible="{Binding !IsEnabled}"
                                                 Fill="{DynamicResource SystemFillColorNeutralBrush}" />
                                    </Panel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ModName}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding CharacterName}" FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="3" Text="{Binding StatusText}" FontSize="12"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
