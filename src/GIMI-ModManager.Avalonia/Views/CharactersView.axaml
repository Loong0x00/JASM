<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:GIMI_ModManager.Avalonia.ViewModels"
             xmlns:items="using:GIMI_ModManager.Avalonia.ViewModels.Items"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="GIMI_ModManager.Avalonia.Views.CharactersView"
             x:DataType="vm:CharactersViewModel"
             x:Name="Root">

    <UserControl.Styles>
        <Style Selector="Border.hidden">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*" Margin="24,16,24,0">
        <!-- Category tabs -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
            <ListBox Grid.Column="0" ItemsSource="{Binding Categories}"
                     SelectedItem="{Binding SelectedCategory}"
                     Background="Transparent" BorderThickness="0" Padding="0">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="4" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="14,6" />
                        <Setter Property="CornerRadius" Value="6" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayNamePlural}" FontWeight="SemiBold" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <Run Text="共" /><Run Text="{Binding TotalMods}" /><Run Text=" 个模组" />
                </TextBlock>
                <Button Content="安装模组" Classes="accent" Command="{Binding InstallModCommand}" />
            </StackPanel>
        </Grid>

        <!-- Filter bar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
            <TextBox Text="{Binding SearchText}" Watermark="搜索…" Width="220" />
            <ComboBox ItemsSource="{Binding Elements}" SelectedItem="{Binding SelectedElement}"
                      MinWidth="110" IsVisible="{Binding IsCharacterCategory}" />
            <ComboBox ItemsSource="{Binding Classes}" SelectedItem="{Binding SelectedClass}"
                      MinWidth="110" IsVisible="{Binding IsCharacterCategory}" />
            <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}" MinWidth="110" />
            <CheckBox Content="只看有模组的" IsChecked="{Binding OnlyWithMods}" VerticalAlignment="Center" />
            <CheckBox Content="显示已隐藏" IsChecked="{Binding ShowHidden}" VerticalAlignment="Center"
                      IsVisible="{Binding IsCharacterCategory}" />
        </StackPanel>

        <ScrollViewer Grid.Row="2">
            <ItemsControl ItemsSource="{Binding Characters}" Margin="0,0,0,24">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="items:CharacterGridItem">
                        <Border Width="132" Height="188" Margin="6" CornerRadius="8" ClipToBounds="True"
                                Classes.hidden="{Binding IsHidden}"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Grid RowDefinitions="*,Auto">
                                <Button Grid.Row="0" Grid.RowSpan="2" Padding="0" Background="Transparent"
                                        BorderThickness="0" HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"
                                        Command="{Binding #Root.((vm:CharactersViewModel)DataContext).OpenCharacterCommand}"
                                        CommandParameter="{Binding}" ToolTip.Tip="{Binding DisplayName}">
                                    <Grid RowDefinitions="*,Auto">
                                        <Image Grid.Row="0" Source="{Binding ImagePath, Converter={StaticResource PathToBitmap}}"
                                               Stretch="UniformToFill" />
                                        <Border Grid.Row="1"
                                                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                                Padding="8,6">
                                            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"
                                                       HorizontalAlignment="Center" FontSize="13" />
                                        </Border>
                                    </Grid>
                                </Button>

                                <!-- Element icon (top-left) -->
                                <Image Grid.Row="0" Width="24" Height="24" Margin="6"
                                       HorizontalAlignment="Left" VerticalAlignment="Top"
                                       IsHitTestVisible="False"
                                       Source="{Binding ElementImagePath, Converter={StaticResource PathToBitmap}}" />

                                <!-- Mod-count badge (top-right) -->
                                <Border Grid.Row="0" IsVisible="{Binding HasMods}" IsHitTestVisible="False"
                                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                                        CornerRadius="10" Padding="7,2" Margin="6"
                                        HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding ModCount}" FontSize="12" FontWeight="Bold" Foreground="White" />
                                </Border>

                                <!-- Pin toggle (bottom-right over image) -->
                                <Button Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Margin="4" Width="28" Height="28" Padding="0" FontSize="14"
                                        Background="#80000000" Foreground="Gold"
                                        Content="{Binding PinGlyph}"
                                        Command="{Binding #Root.((vm:CharactersViewModel)DataContext).TogglePinCommand}"
                                        CommandParameter="{Binding}"
                                        ToolTip.Tip="置顶" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
